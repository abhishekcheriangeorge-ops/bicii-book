# BICII Admin environment. Copy to .env.local and fill in. Never commit values.
# Every variable read by src/lib/env.ts is listed here.

# --- Public (inlined into the browser bundle) ---------------------------------
# Supabase API URL. Local devstack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. RLS applies to everything it can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public website base URL; QR payloads are {this}/q/{shortId} (PLAN D9).
NEXT_PUBLIC_PUBLIC_SITE_URL=https://bicii.vercel.app

# --- Server only --------------------------------------------------------------
# Postgres connection for the devstack, DB tests (server only) and type generation.
# Local devstack: postgres://postgres:postgres@127.0.0.1:5432/bicii_dev
# (`npm run devstack:env` writes all the local values into .env.local.)
DATABASE_URL=
# Service-role key (bypasses RLS). Server only: src/lib/admin/** (Auth admin API,
# e.g. inviting staff) and src/lib/integrations/** (ESLint enforces this).
# Required for Settings → Staff → Invite.
SUPABASE_SERVICE_ROLE_KEY=
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# --- Phase 10: Shopify (leave empty until then) ------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Vercel -------------------------------------------------------------------
# Stable Server Action encryption key across instances (set in Vercel, not here).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
